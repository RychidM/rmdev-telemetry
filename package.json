{
  "name": "@rmdev/telemetry",
  "version": "0.1.1",
  "description": "Policy-injected error reporting for Node.js services",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist",
    "docs/build.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "release:pr": "bash scripts/release-pr.sh"
  },
  "dependencies": {
    "@sentry/core": "11.16.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
